+    All constants are pre-declared module-level values; none is derived from the quantity
+    under test.  epsilon_Delta is NOT part of acceptance - it is a reported
+    numerical-resolution quantity.
+    """
+    return {
+        "P1_monotone_decreasing": bool(all(b < a for a, b in zip(rel_err, rel_err[1:]))),
+        "P2_ci_lower_ge_P_MIN": bool(ci_lo >= P_MIN),
+        "P3_powerlaw_residual_le_R_MAX": bool(resid_max <= R_MAX),
+        "P4_floor_datum_le_FLOOR_MAX": bool(d16_32 <= FLOOR_MAX),
+    }
+
