+def loglog_max_abs_residual(hs, errs, slope):
+    """max |ln(err) - (intercept + slope*ln(h))| for the fitted power law (P3 input)."""
+    x = np.log(np.asarray(hs, float))
+    y = np.log(np.asarray(errs, float))
+    intercept = y.mean() - slope * x.mean()
+    return float(np.max(np.abs(y - (intercept + slope * x))))
+
+
+def check_5i_criterion(meshes, rel_err, d16_32, ci_lo, resid_max):
