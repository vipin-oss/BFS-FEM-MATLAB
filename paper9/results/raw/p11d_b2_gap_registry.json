    "cross_check_2": "mpmath.polyroots of the characteristic polynomial (independent algorithm) at spot frequencies",
    "status_policy": "judge_status() derives every status from max_error vs tol; non-finite errors FAIL; no code path can emit PASS with error >> tol"
  },
  "parameter_semantics": {
    "l": "gradient-length parameter in the PDE (mu_0 = c33 l^2 prefactor); dimension [m]",
